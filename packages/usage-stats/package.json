{
  "name": "@moonlight2893267956/dsh-usage-stats",
  "description": "Cross-session per-day token-usage statistics for DeepSeek Harness: a Host service folds the durable session logs into daily totals and serves them over a Typert Remote; the bundled client half renders the Usage settings page.",
  "version": "0.1.0",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonlight2893267956/dsh-usage-stats.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./route": {
      "types": "./lib/types/route.d.ts",
      "default": "./lib/types/route.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "build:host": "tsc -b tsconfig.node.json",
    "build:client": "tsc -b tsconfig.client.json",
    "bundle": "tsdown",
    "build": "pnpm run build:host && pnpm run bundle && pnpm run build:client",
    "typecheck": "pnpm run build",
    "watch": "tsdown --watch",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-storage-domain": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "~0.2.1-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/cordis-plugin-include": "~1.0.10-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6-alpha.1",
    "@deepseek-ai/dsh-client-locale": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-modules": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-store": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-test-runtime": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-package-manifest": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-persistence-jsonl": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-storage": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-storage-domain": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-storage-json": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-storage-sqlite": "~0.2.1-alpha.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "immer": "^10.1.1",
    "jsdom": "^27.0.0",
    "lightningcss": "^1.30.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "zustand": "~4.4.7"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "koffi"
    ]
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-store"
      ],
      "platform": "web"
    }
  }
}
